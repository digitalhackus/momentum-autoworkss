# MongoDB
MONGODB_URI=mongodb://localhost:27017/momentum-autoworks

# Auth — required for login (JWT signing)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Email (Nodemailer) — required for sending OTP to user's inbox
# If not set, no email is sent: OTP is shown in the app (dev) and logged in the server console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@example.com

# Server
PORT=5000
NODE_ENV=development
